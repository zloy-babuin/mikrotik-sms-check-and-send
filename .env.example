# --- MikroTik (SSH) ---
MIKROTIK_HOST=192.0.2.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=your_password_here

# --- Получатель ---
EMAIL_TO=

# --- Gmail (основной канал, smtp.gmail.com:587 STARTTLS; нужен пароль приложения) ---
GMAIL_USER=
GMAIL_PASSWORD=

# --- Yandex (первый fallback, smtp.yandex.ru:465 SSL; нужен пароль приложения) ---
YANDEX_USER=
YANDEX_PASSWORD=

# --- Rambler (второй fallback; можно указать любой SMTP) ---
RAMBLER_USER=
RAMBLER_PASSWORD=
# Адрес в From, должен совпадать с RAMBLER_USER
RAMBLER_SENDER_NAME=
RAMBLER_SMTP_SERVER=smtp.rambler.ru
RAMBLER_SMTP_PORT=465
RAMBLER_SMTP_USE_SSL=true
